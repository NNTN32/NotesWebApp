# Copy to .env for local `docker compose up`. Never commit real values.
# Production values live only in Dokploy (see docs/secrets-and-credentials.md).

DB_URL=jdbc:postgresql://localhost:5432/NoteApp
DB_USERNAME=postgres
DB_PASSWORD=change-me-local

JWT_SECRET=change-me-local-at-least-32-chars-long
JWT_EXPIRATION=900000
JWT_REFRESH=604800000

REDIS_HOST=localhost
REDIS_PORT=6379

RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_STOMP_PORT=61613

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DOCKERHUB_USERNAME=
APP_VERSION=latest
